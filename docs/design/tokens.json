{
  "$schema": "know-meet-tokens/v1",
  "name": "Know Meet",
  "version": "1.0.0",
  "themes": {
    "dark": {
      "bg": "#0B0F14",
      "bg-2": "#111620",
      "surface": "#161D29",
      "card": "#1C2535",
      "card-hov": "#202B40",
      "muted": "#253044",
      "fg": "#E8EDF3",
      "fg-sub": "#A7B0BC",
      "ember": "#FF6A3D",
      "ember-btn": "#FF6A3D",
      "on-ember": "#0B0F14",
      "ember-text": "#FF6A3D",
      "ember-soft": "#2B1A18",
      "cyan": "#00C2DC",
      "cyan-text": "#00C2DC",
      "cyan-soft": "rgba(0, 194, 220, 0.14)",
      "green": "#22C55E",
      "amber": "#F59E0B",
      "red": "#EF4444",
      "danger-btn": "#DC2626",
      "font-display": "'Space Grotesk', ui-sans-serif, system-ui, sans-serif",
      "font-body": "'Inter', ui-sans-serif, system-ui, sans-serif",
      "font-mono": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace",
      "text-xs": "12px",
      "text-sm": "14px",
      "text-base": "16px",
      "text-lg": "18px",
      "text-xl": "24px",
      "text-2xl": "clamp(28px, 2.2vw + 16px, 40px)",
      "text-display": "clamp(40px, 4vw + 16px, 72px)",
      "s1": "4px",
      "s2": "8px",
      "s3": "12px",
      "s4": "16px",
      "s5": "24px",
      "s6": "32px",
      "s7": "48px",
      "s8": "64px",
      "radius": "12px",
      "radius-tile": "16px",
      "radius-lg": "20px",
      "radius-pill": "999px",
      "dur-fast": "150ms",
      "dur": "240ms",
      "dur-panel": "280ms",
      "dur-exit": "190ms",
      "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "ease-in": "cubic-bezier(0.55, 0, 0.75, 0.25)",
      "dot-breathe": "3.2s",
      "dot-think": "0.9s",
      "dot-ripple": "1.6s"
    },
    "light": {
      "bg": "#F7F7F8",
      "bg-2": "#FFFFFF",
      "surface": "#FAFBFC",
      "card": "#FFFFFF",
      "card-hov": "#F2F4F7",
      "muted": "#EEF0F3",
      "fg": "#0B0F14",
      "fg-sub": "#4B5563",
      "ember": "#E04E28",
      "ember-btn": "#C13E1E",
      "on-ember": "#FFFFFF",
      "ember-text": "#C13E1E",
      "ember-soft": "#FBE8E1",
      "cyan": "#0891B2",
      "cyan-text": "#0E7490",
      "cyan-soft": "rgba(8, 145, 178, 0.12)",
      "green": "#16A34A",
      "amber": "#D97706",
      "red": "#DC2626"
    }
  }
}