.DS_Store
*.artifact.json
.env
.env.*
.prometheus/

# Workspace build outputs and caches (c01)
node_modules/
.turbo/
dist/
# Hosted web build (wr06): bundle and the CSP header artifact written next to it
dist-hosted*
coverage/
*.tsbuildinfo
target/
.dart_tool/

# Generated surfaces (c05): Flutter, SQLite baselines, IDE files
build/
.flutter-plugins-dependencies
local.properties
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
.data/

# prometheus-context-bootstrap
.prometheus/.writer.lock
.prometheus/.review-pending
.claude/settings.json.bak.*

# Prebuilt third-party skill binaries (reinstalled by the skill; ~18 MB each)
**/skills/impeccable/scripts/bin/

# Key and certificate material must never be committed (secrets come from the environment)
*.pem
*.p8
*.p12
*.pfx
*.key
*.jks
*.keystore
android/key.properties
**/android/key.properties

# Raw run evidence stays local; commit summaries only (decision 2026-11-16, web-release)
*.har
.kbd-orchestrator/**/evidence/**/playwright.json
.kbd-orchestrator/**/evidence/**/*.log
.kbd-orchestrator/**/evidence/**/test-results/
.kbd-orchestrator/**/evidence/**/html/
.kbd-orchestrator/**/evidence/**/playwright-report/
.kbd-orchestrator/**/evidence/**/trace.zip
