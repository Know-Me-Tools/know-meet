 "navigation": {
  "source": "DESIGN.md Adaptive layout (D-8, operator 2026-11-11); reference revision v2 (route-inventory.json v2.0.0, discrepancy-log.md section F). frame.nav-collapsed and frame.nav-open are retired (inScope false) and have no app route.",
  "rule": "One <nav aria-label=\"Primary\" data-testid=\"km-appnav\"> in every width class; the class is exposed as data-nav-class = bar (<600) | rail (600-1023) | inline (>=1024). Never separate DOM nodes, so focus survives the morph. km-nav-toggle is retired and must not render at any width.",
  "status": "proposed: client-shell must confirm the data-nav-class and km-nav-item/km-nav-indicator testids before c09 merges; until then these cells are BLOCKED, never skipped",
  "classBounds": {
   "bar": "width < 600",
   "rail": "600 <= width < 1024",
   "inline": "width >= 1024"
  },
  "morphTokens": {
   "duration": "dur-nav-morph",
   "label": "dur-nav-label",
   "reflow": "dur-reflow",
   "easing": "ease-layout"
  }
 },
 "checks": {
  "frame.nav-resize-reduced-motion": {
   "kind": "a11y-motion-check",
   "feature": "features/motion.feature",
   "scenarios": [
    "Crossing a width class morphs the navigation with the nav tokens",
    "Reduced motion makes the navigation morph instant"
   ],
   "pixelCell": false,
   "adjudication": "ADJ-2"
  },
  "frame.flat-controls": {
   "kind": "a11y-computed-style-check",
   "feature": "features/flat-controls.feature",
   "pixelCell": false,
   "adjudication": "ADJ-3"
  }
 }
