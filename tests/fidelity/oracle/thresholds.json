 "exceptionRubric": {
  "adjudicator": "design-lead",
  "whoMayRequest": [
   "ui-engineer",
   "client-shell",
   "mobile-engineer",
   "bdd-quality"
  ],
  "when": "Before the c13 boundary run starts. Requests raised during or after the run apply only to a later, separately authorised run.",
  "allowedGrounds": [
   {
    "id": "R1-font-rasterisation",
    "description": "Sub-pixel anti-aliasing differences from font rendering only, with identical glyph positions and metrics.",
    "maxRaise": "maxDiffPixelRatio up to 0.02 for that cell"
   },
   {
    "id": "R2-prototype-defect",
    "description": "The prototype itself is wrong against tokens.json or the brand guide (source hierarchy: tokens.json > brand guide > prototype > live prototype) and design-lead records the correct reference.",
    "maxRaise": "cell compared against a design-lead approved replacement baseline, recorded with its digest"
   },
   {
    "id": "R3-dynamic-content",
    "description": "Content the frozen clock cannot fix (for example a random seed) and that is not a design property.",
    "maxRaise": "mask the dynamic region only, region recorded as CSS selector and box"
   },
   {
    "id": "R4-platform-chrome",
    "description": "Native or browser chrome outside the page (scrollbars, focus ring default) that the design does not specify.",
    "maxRaise": "mask or threshold up to 0.02"
   }
  ],
  "neverAllowed": [
   "Colour, spacing, radius, type scale or weight differences",
   "Missing or extra UI elements",
   "Layout reflow or different page height",
   "Theme-specific differences (a cell may not be excepted in one theme to hide a token bug)",
   "Raising the global default"
  ],
  "record": "Append to `adjudications`: {cell: state/theme/viewport, ground, change, rationale, decidedBy: design-lead, decidedAt, baselineSha256}. Each record is evidence for the boundary run."
 },
