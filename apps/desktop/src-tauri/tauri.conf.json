{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Know Meet",
  "version": "0.1.0",
  "identifier": "tools.know-me.meet",
  "build": {
    "beforeDevCommand": "pnpm --filter @know-meet/web run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm --filter @know-meet/web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Know Meet",
        "width": 900,
        "height": 700,
        "minWidth": 380,
        "minHeight": 480,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
