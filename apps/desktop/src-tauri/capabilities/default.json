{
  "identifier": "notes-window",
  "description": "Local note commands and the custom titlebar window controls (c09 9.2), main window only",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-list-notes",
    "allow-create-note", "allow-list-capabilities",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-is-maximized"
  ]
}