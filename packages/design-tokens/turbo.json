{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "cache": false
    },
    "build": {
      "dependsOn": ["generate"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/design/tokens.json",
        "$TURBO_ROOT$/docs/design/tokens.css"
      ],
      "outputs": []
    },
    "test": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/docs/design/tokens.json"]
    }
  }
}
