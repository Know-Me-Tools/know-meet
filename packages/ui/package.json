{
  "name": "@know-meet/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Know Meet shared shadcn/ui kit (OpenSpec c08): Base UI primitives restyled to docs/design, themed only by @know-meet/design-tokens.",
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@know-meet/design-tokens": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.70.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0"
  },
  "peerDependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "7.0.2"
  }
}
