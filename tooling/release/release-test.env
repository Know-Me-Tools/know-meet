# Local test values for the packaged boundary run (contract amendment 2).
# Not secrets. Read by `docker compose --env-file` and exported to the Playwright
# runner. LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET are NOT here: they
# come only from the shell that starts compose.
#
# Why these limits are raised: the suite plays about 30 people creating meetings
# from one machine, so every request shares one source address. The production
# per-address limits (services/livekit defaults and the cluster overlay) are
# unchanged and are not part of the gate.

# Ports: 8080 and 8081 are held on the boundary host.
KM_PROXY_PORT=18080
KM_STATIC_PORT=18081
KM_SITE_ORIGIN=http://localhost:18080

# Token service per-address limits (test only).
KM_RATE_LIMIT_BURST=600
KM_RATE_LIMIT_REFILL_SECONDS=60
KM_MEETING_RATE_LIMIT_BURST=200
KM_MEETING_RATE_LIMIT_REFILL_SECONDS=600
KM_MAX_CODES_PER_CLIENT=200
KM_MAX_USED_CODES_PER_CLIENT=1000
KM_TOKEN_TTL_SECONDS=600

# Runner inputs that must match the values above.
KM_RELEASE_BASE_URL=http://localhost:18080
KM_RELEASE_STATIC_URL=http://127.0.0.1:18081
KM_RELEASE_DEFAULT_BUILD_URL=http://127.0.0.1:4173
KM_RELEASE_TOKEN_TTL_SECONDS=600
KM_RELEASE_RATE_LIMIT_BURST=600
KM_RELEASE_RATE_LIMIT_REFILL_SECONDS=60
