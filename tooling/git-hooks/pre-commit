#!/bin/sh
# Know Meet pre-commit hook (c01). Installed by `pnpm install` via
# `git config core.hooksPath tooling/git-hooks`. Runs every repo rule except the
# slow native lints (clippy, flutter analyze), which run in `pnpm run lint` and CI.
set -eu
cd "$(git rev-parse --show-toplevel)"
exec node tooling/repo-rules/src/lint-all.ts --skip lint:native
