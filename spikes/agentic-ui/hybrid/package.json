    "preview": "vite preview --port 4175 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@a2ui/react": "0.15.0",
    "@a2ui/web_core": "0.15.0",
    "@ag-ui/client": "1.0.4",
    "@ag-ui/core": "1.0.4",
    "@assistant-ui/react": "0.15.33",
    "@assistant-ui/react-ag-ui": "0.1.2",
    "@assistant-ui/react-streamdown": "0.3.21",
    "@prometheus-ags/entity-graph-core": "4.3.0",
    "@streamdown/code": "2.0.0",
    "@streamdown/math": "1.0.3",
    "dompurify": "3.4.17",
    "katex": "0.16.47",
    "mermaid": "11.17.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rxjs": "7.8.1",
    "streamdown": "2.7.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
