{
  "name": "@know-meet/agentic-ui-spike-hybrid",
  "private": true,
  "version": "0.0.0",
  "description": "c15 prototype H (hybrid): assistant-ui AG-UI runtime behind a Know Meet ChatSession port, entity-graph as the durable store (checkpoints + AG-UI event journal), Streamdown, A2UI. Standalone: not part of the root pnpm workspace.",
