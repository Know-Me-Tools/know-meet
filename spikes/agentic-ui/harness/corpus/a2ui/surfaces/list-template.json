{
  "corpusFormatVersion": 1,
  "a2uiSpecVersion": "1.0",
  "a2uiWebCorePackage": "@a2ui/web_core@0.15.0",
  "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json",
  "validation": {
    "mode": "strict-pass"
  },
  "id": "list-template",
  "title": "Template list bound to a data-model array",
  "description": "A List whose children come from a template over /attendees; the data model then grows by one item.",
  "surfaceId": "km-attendees",
  "messages": [
    {
      "version": "1.0",
      "createSurface": {
        "surfaceId": "km-attendees",
        "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
      }
    },
    {
      "version": "1.0",
      "updateComponents": {
        "surfaceId": "km-attendees",
        "components": [
          {
            "id": "root",
            "component": "Card",
            "child": "col"
          },
          {
            "id": "col",
            "component": "Column",
            "children": [
              "heading",
              "people"
            ],
            "align": "stretch"
          },
          {
            "id": "heading",
            "component": "Text",
            "text": "Attendees"
          },
          {
            "id": "people",
            "component": "List",
            "children": {
              "componentId": "person_row",
              "path": "/attendees"
            }
          },
          {
            "id": "person_row",
            "component": "Row",
            "children": [
              "person_name",
              "person_role"
            ]
          },
          {
            "id": "person_name",
            "component": "Text",
            "text": {
              "@path": "name"
            }
          },
          {
            "id": "person_role",
            "component": "Text",
            "text": {
              "@path": "role"
            }
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "km-attendees",
        "path": "/attendees",
        "value": [
          {
            "name": "Ana",
            "role": "host"
          },
          {
            "name": "Ben",
            "role": "guest"
          }
        ]
      }
    },
    {
      "version": "1.0",
      "updateDataModel": {
        "surfaceId": "km-attendees",
        "path": "/attendees/2",
        "value": {
          "name": "Concierge",
          "role": "agent"
        }
      }
    }
  ],
  "interactions": [],
  "expected": {
    "renderedComponentIds": [
      "root",
      "col",
      "heading",
      "people"
    ],
    "fallbackComponentIds": [],
    "visibleText": [
      "Attendees",
      "Ana",
      "host",
      "Ben",
      "guest",
      "Concierge",
      "agent"
    ],
    "blockedMediaUrls": [],
    "dataModel": {
      "attendees": [
        {
          "name": "Ana",
          "role": "host"
        },
        {
          "name": "Ben",
          "role": "guest"
        },
        {
          "name": "Concierge",
          "role": "agent"
        }
      ]
    }
  },
  "flutterNotes": "Template instances have no stable component id of their own; compare the three rendered rows by text, in order."
}
