            "delta": " The"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " Researcher"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " could"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " not"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " reach"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " the"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_CONTENT",
            "messageId": "msg-rsn-1",
            "delta": " archive."
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_END",
            "messageId": "msg-rsn-1"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "MESSAGES_SNAPSHOT",
            "messages": [
              {
                "id": "msg-user-hist",
                "role": "user",
                "content": "Earlier question from last week."
              },
              {
                "id": "msg-asst-hist",
                "role": "assistant",
                "content": "Earlier answer from last week."
              },
              {
                "id": "msg-rsn-1",
                "role": "assistant",
                "content": "The Scribe reports two new decisions. The Researcher could not reach the archive."
              }
