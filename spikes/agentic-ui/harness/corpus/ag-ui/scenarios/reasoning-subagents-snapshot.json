            "entityId": "rsn-2",
            "encryptedValue": "ZW5jcnlwdGVkLXJlYXNvbmluZy1ibG9i"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "SUBAGENT_STARTED",
            "subagentRunId": "sub-scribe-1",
            "name": "scribe"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "SUBAGENT_FINISHED",
            "subagentRunId": "sub-scribe-1",
            "outcome": {
              "type": "success"
