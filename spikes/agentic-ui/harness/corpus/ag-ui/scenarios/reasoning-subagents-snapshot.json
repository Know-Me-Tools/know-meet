{
  "corpusFormatVersion": 1,
  "agUiCorePackage": "@ag-ui/core@1.0.4",
  "agUiProtocolVersion": "1.0",
  "pacing": {
    "tokensPerSecond": 120,
    "eventGapMs": 15
  },
  "interactions": [],
  "validity": "valid",
  "id": "reasoning-subagents-snapshot",
  "title": "Reasoning, encrypted reasoning, subagents and MESSAGES_SNAPSHOT",
  "description": "REASONING_* (including CHUNK and ENCRYPTED_VALUE, which must not be shown as text), SUBAGENT_STARTED/FINISHED/ERROR, and a trailing MESSAGES_SNAPSHOT. AG-UI semantics: MESSAGES_SNAPSHOT replaces the message list, so the final transcript is exactly the three snapshot messages (history + the answer); the live user turn and reasoning are replaced.",
  "tags": [
    "@reasoning",
    "@subagents",
    "@snapshot"
  ],
  "userPrompt": "Ask the Scribe and the Researcher what changed since last week.",
  "runs": [
    {
      "trigger": {
        "kind": "initial"
      },
      "items": [
        {
          "kind": "event",
          "event": {
            "type": "RUN_STARTED",
            "threadId": "thread-from-request",
            "runId": "run-from-request"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_START",
            "messageId": "rsn-1"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_START",
            "messageId": "rsn-1",
            "role": "reasoning"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": "The"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
