            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " a"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " diff."
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " I"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " will"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " ask"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
