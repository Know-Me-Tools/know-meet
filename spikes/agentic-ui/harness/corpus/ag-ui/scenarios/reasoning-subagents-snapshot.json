            "result": {
              "decisions": 2
            }
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "SUBAGENT_STARTED",
            "subagentRunId": "sub-research-1",
            "name": "researcher"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "SUBAGENT_ERROR",
            "subagentRunId": "sub-research-1",
            "message": "Archive unreachable.",
            "code": "ARCHIVE_DOWN"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "TEXT_MESSAGE_START",
            "messageId": "msg-rsn-1",
            "role": "assistant"
          }
        },
        {
          "kind": "event",
