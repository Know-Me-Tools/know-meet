          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " for"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
            "delta": " notes"
          }
        },
        {
          "kind": "event",
          "event": {
            "type": "REASONING_MESSAGE_CONTENT",
            "messageId": "rsn-1",
